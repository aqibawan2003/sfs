PORT=5000

# Local MongoDB (default). For Atlas, use:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>
MONGODB_URI=mongodb://localhost:27017/student-facility-system

# Long random string used to sign JWTs — generate your own, don't reuse this
JWT_SECRET=replace_with_a_long_random_secret

# Gmail address + Gmail App Password (not your normal Gmail password) used to send OTP/notification emails
EMAIL=your_email@gmail.com
APP_PASSWORD=your_gmail_app_password

# Optional: where Contact Us form submissions are emailed to.
# Defaults to EMAIL above if not set.
CONTACT_NOTIFY_EMAIL=

# Email verification settings
REQUIRE_EMAIL_SUCCESS=true

# Stripe secret key - checkout confirms payment in-browser via CardElement,
# no webhook needed for the app to function.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# CORS - comma-separated list of allowed frontend URLs (also used by Socket.IO)
ALLOWED_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app

# Cloudinary - used for device image uploads on registration/profile forms
# (Sign up free at https://cloudinary.com — Dashboard shows all 3 values)
# If these are left unset, device upload shows a friendly error but the
# "Image URL" option still works fine.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to 'true' to keep console.log debug output in production logs (Render).
# Leave unset in production for cleaner logs.
DEBUG_LOGS=false

# --- Not yet wired up to any code - safe to leave unset ---
# JAZZCASH_MERCHANT_ID=        # JazzCash is UI-only and shown as "Locked" right now, not integrated
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=
# JAZZCASH_PAYMENT_URL=

# LOCAL TESTING ONLY — simulate successful payments when Stripe is unreachable
# (e.g. IP/region blocks). Hard-disabled in production automatically.
STRIPE_MOCK=false
